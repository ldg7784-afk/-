# 서버 포트 설정
PORT=3000
NODE_ENV=development

# 교사용 보안 접근 코드 (서버 검증용 비밀코드 - 배포 시 반드시 변경하십시오)
TEACHER_ACCESS_CODE=1234

# 학교 및 기관 기본 정보
INSTITUTION_NAME=26] 고2 체육과 줄넘기 활동
PRIVACY_OFFICER_NAME=체육교과 담당교사
PRIVACY_OFFICER_CONTACT=pe_dept@school.kr

# 데이터 보관 주기 (개월 단위)
DATA_RETENTION_MONTHS=12

# 가명/학번 단독 입력 허용 여부
ALLOW_ANONYMOUS_STUDENT=true

# (선택) Firebase Firestore 환경변수 기반 연동 설정 (serviceAccountKey.json 파일 사용 시 생략 가능)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...-----END PRIVATE KEY-----\n"
